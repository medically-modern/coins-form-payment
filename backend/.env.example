# Monday.com API token.
#
# Reads and writes TWO boards:
#   Secondary Claims 18413019028 — the coinsurance payment flow
#   New Order        18405457690 — the cash pay flow (src/cashPay/)
#
# (This line used to say "Subscription Board 18407459988", which is a
#  different repo's board. CLAUDE.md §3 recorded the comment as stale;
#  corrected 2026-09-22.)
MONDAY_TOKEN=

# JWT secret for session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=

# Redis connection URL (Railway provides this)
REDIS_URL=redis://localhost:6379

# Admin API key for /admin/generate-token endpoint
ADMIN_API_KEY=

# Frontend URL (where the payment form is hosted)
PAYMENT_URL=https://invoice.medicallymodern.com

# Stripe (future)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# RingCentral (for patient SMS)
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_FROM_NUMBER=+13475037148
RC_SERVER=https://platform.ringcentral.com

# ─── Cash pay (src/cashPay/) ───
#
# Shared bearer token the Command Center sends to POST /api/cash-pay/create-link.
# ⚠️ UNSET DISABLES THE ROUTE (503) rather than leaving it open — it mints
# Stripe payment links, so it must never be reachable because somebody forgot
# to configure it. Generate with: openssl rand -hex 32
CASH_PAY_SERVICE_TOKEN=
